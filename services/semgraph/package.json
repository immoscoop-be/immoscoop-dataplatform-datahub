{
  "name": "immoscoop-ptditt-semgraph",
  "version": "0.1.0",
  "private": true,
  "description": "Semantic chart service: renders charts by meaning, following the Immoscoop chart language.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "render:examples": "node scripts/render-examples.ts",
    "schemas": "node scripts/write-schemas.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fastify": "5.12.5",
    "vega": "6.4.0",
    "vega-lite": "6.4.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  }
}
