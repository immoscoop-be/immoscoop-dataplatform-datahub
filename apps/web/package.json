{
  "name": "@datahub/web",
  "version": "0.0.0",
  "private": true,
  "description": "The web app of Data Hub and its small server, which keeps Users signed in. See docs/architecture/services/web.md.",
  "type": "module",
  "main": "./dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/main.js",
    "build:client": "vite build --config client/vite.config.ts",
    "check": "svelte-check --tsconfig client/tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "@datahub/auth": "workspace:*",
    "@datahub/server": "workspace:*",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@datahub/contracts": "workspace:*",
    "@datahub/ui": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "jsdom": "30.1.2",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
