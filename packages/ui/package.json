{
  "name": "@datahub/ui",
  "version": "0.0.0",
  "private": true,
  "description": "The look of Data Hub in Svelte: the tokens, the foundations and the components that the web app and the MCP App share, layers 1 to 5 of docs/design/components.md (DEC-PF-28). Its values come from docs/design/tokens.css.",
  "type": "module",
  "exports": {
    "./*.svelte": {
      "types": "./src/*.svelte",
      "svelte": "./src/*.svelte",
      "default": "./src/*.svelte"
    },
    "./*.css": "./src/*.css",
    "./*.js": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check": "svelte-check --tsconfig tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@datahub/contracts": "workspace:*",
    "@fontsource/poppins": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@phosphor-icons/core": "2.1.1",
    "@xyflow/svelte": "1.7.0",
    "sql-formatter": "15.9.0"
  },
  "peerDependencies": {
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@testing-library/svelte": "5.4.2",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
